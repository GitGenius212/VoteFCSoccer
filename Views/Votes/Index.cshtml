@model IEnumerable<VoteFCSoccer.Models.LibelleVoteCandidatViewModel>

@{
    ViewData["Title"] = "Liste des Votes";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-primary">Liste des Votes</h1>
        <a asp-action="Create" class="btn btn-success btn-lg">
            <i class="fas fa-plus-circle"></i> Ajouter un nouveau Vote
        </a>
    </div>

    <div class="card shadow-lg">
        <div class="card-body">
            <table class="table table-bordered table-hover align-middle text-center">
                <thead class="table-primary">
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Votant</th>
                        <th scope="col">ID Candidat</th>
                        <th scope="col">Nom du Candidat</th>
                        <th scope="col">Logo</th>
                        <th scope="col" class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody id="votes">
                    <!-- Contenu généré dynamiquement -->
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script src="~/js/Vote.js"></script>
    <script type="text/javascript">
        getVotes();
    </script>
}
