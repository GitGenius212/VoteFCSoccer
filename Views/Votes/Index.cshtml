@model IEnumerable<VoteFCSoccer.Models.LibelleVoteEquipeViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Vote.voteId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Vote.Votant)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Equipe)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Equipe.Nom)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Equipe.Logo)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) { 
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Vote.voteId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Vote.Votant)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Equipe.EquipeId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Equipe.Nom)
            </td>

            <td>
                <img width="100px" height="100px" src="images/@item.Equipe.Logo" alt="Logo de l'équipe" />
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Vote.voteId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Vote.voteId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Vote.voteId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
