@model VoteFCSoccer.Models.Vote

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Vote</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Index" >
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Votant" class="control-label"></label>
                <input asp-for="Votant" id="votant" class="form-control" />
                <span asp-validation-for="Votant" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CandidatId" class="control-label">Candidats</label>
                <select asp-for="CandidatId" id="candidatId" class ="form-control" asp-items="ViewBag.CandidatId"></select>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" id="createVote" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script src="~/js/Vote.js"></script>
    <script>
        document.getElementById("createVote").addEventListener("click", function (event) {
        event.preventDefault();
        var candidatId = document.getElementById("candidatId").value;
        var votant = document.getElementById("votant").value;
        
    
        const vote = {
            votant: votant, 
            candidatId: candidatId
            
        };
    
        fetch('/api/VoteApi', {
            method: "POST",
            headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(vote)
        })
        .then(response => {
        if (response.ok) {
            // Redirection vers l'Index après succès
            window.location.href = '/Votes';
        } else {
            // Affiche un message d'erreur si la création échoue
            alert("Erreur lors de la création du vote.");
        }
    })
    .then(async () => {
        try {
            await connection.invoke("SendVoteHub");
        } catch (err) {
            console.error(err);
        }
    })
        .catch(error => alert(error));

    });
    </script>
}
