@model VoteFCSoccer.Models.Vote

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Vote</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Votant)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Votant)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Candidat)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Candidat.CandidatId)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" id="id" asp-for="voteId" />
        <input type="submit" value="Delete" id="deleteVote" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>

@section Scripts{
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script src="~/js/Vote.js"></script>
    <script>
        var id = document.getElementById('id').value;
        const deleteUrl = `/api/VoteApi/${id}`
        document.getElementById("deleteVote").addEventListener("click", function (event) {
            event.preventDefault();
    fetch(deleteUrl, {
        method: "DELETE",
        headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json'
        }
    })
    .then(response => {
        if (response.ok) {
            window.location.href = '/Votes';
        } else {
            throw new Error('Network response was not ok.');
        }
        // Vérifie si la réponse est vide avant de la convertir en JSON
        const contentType = response.headers.get('content-type');
        if (contentType && contentType.indexOf('application/json') !== -1) {
            return response.json();
        } else {
            return null; // Si la réponse est vide
        }
    })
    .then(data => {
        if (data) {
            // Faites quelque chose avec les données si nécessaire
            console.log(data);
        }
        
    })
    .then(async () => {
        try {
            await connection.invoke("SendVoteHub");
        } catch (err) {
            console.error(err);
        }
    })
    .catch(error => alert(error.message));
});
    </script>
    
}
