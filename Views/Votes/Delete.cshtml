@model VoteFCSoccer.Models.Vote

@{
    ViewData["Title"] = "Supprimer un Vote";
}

<div class="container mt-5">
    <div class="card shadow-lg border-danger">
        <div class="card-header bg-danger text-white text-center">
            <h1 class="card-title">Supprimer un Vote</h1>
        </div>
        <div class="card-body">
            <h4 class="text-center text-danger">Êtes-vous sûr de vouloir supprimer ce vote ?</h4>
            <div class="mt-4">
                <h4 class="text-center text-dark">Détails du vote</h4>
                <hr class="border border-danger w-75 mx-auto">
                <dl class="row">
                <dt class="col-sm-4 text-end  fw-bold">Votant</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Votant)</dd>

                <dt class="col-sm-4 text-end fw-bold">Candidat</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Candidat.CandidatId)</dd>
            </dl>
            </div>
            
        </div>

        <div class="card-footer text-center">
            <form asp-action="Delete" class="d-inline">
                <input type="hidden" id="id" asp-for="voteId" />
                    <button type="submit" id="deleteVote" class="btn btn-danger btn-lg">
                        <i class="fas fa-trash-alt"></i> Supprimer
                    </button>     
            </form>
            <a asp-action="Index" class="btn btn-secondary btn-lg ms-3">
                <i class="fas fa-arrow-left"></i> Annuler
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script src="~/js/Vote.js"></script>
    <script>
        const id = document.getElementById('id').value;
        const deleteUrl = `/api/VoteApi/${id}`;
        document.getElementById("deleteVote").addEventListener("click", function (event) {
            event.preventDefault();

            fetch(deleteUrl, {
                method: "DELETE",
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json'
                }
            })
            .then(response => {
                if (response.ok) {
                    window.location.href = '/Votes';
                } else {
                    throw new Error('Erreur réseau : ' + response.status + ' - ' + response.statusText);
                }
            })
            .then(async () => {
                try {
                    await connection.invoke("SendVoteHub");
                } catch (err) {
                    console.error(err);
                }
            })
            .catch(error => alert("Erreur : " + error.message));
        });
    </script>
}
