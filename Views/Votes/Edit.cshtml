@model VoteFCSoccer.Models.Vote

@{
    ViewData["Title"] = "Modifier un Vote";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-primary">Modifier un Vote</h1>
        
    </div>

    <div class="card shadow-lg">
        <div class="card-body">
            <form asp-action="Edit" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <input type="hidden" id="edit-id" asp-for="voteId" />

                <div class="mb-3">
                    <label asp-for="Votant" class="form-label fw-bold">Votant</label>
                    <input asp-for="Votant" id="votant" class="form-control" />
                    <span asp-validation-for="Votant" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CandidatId" class="form-label fw-bold">Candidat</label>
                    <select asp-for="CandidatId" id="candidatId" class="form-select" asp-items="ViewBag.CandidatId"></select>
                    <span asp-validation-for="CandidatId" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <button type="submit" id="editVote" class="btn btn-primary">
                        <i class="fas fa-save"></i> Enregistrer
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-times"></i> Annuler
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script src="~/js/Vote.js"></script>
    <script>
        document.getElementById("editVote").addEventListener("click", function (event) {
            event.preventDefault();

            var votant = document.getElementById("votant").value;
            var candidatId = document.getElementById("candidatId").value;
            var voteId = document.getElementById("edit-id").value;

            const vote = {
                voteId: parseInt(voteId, 10),
                votant: votant.trim(),
                candidatId: parseInt(candidatId, 10),
            };

            fetch(`/api/VoteApi/${voteId}`, {
                method: "PUT",
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(vote)
            })
            .then(response => {
                if (response.ok) {
                    window.location.href = '/Votes';
                } else {
                    throw new Error(`Erreur réseau: ${response.status} - ${response.statusText}`);
                }
            })
            .then(async () => {
                try {
                    await connection.invoke("SendVoteHub");
                } catch (err) {
                    console.error(err);
                }
            })
            .catch(error => alert("Erreur: " + error.message));
        });
    </script>
}
