@model VoteFCSoccer.Models.Vote

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Vote</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" >
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" id="edit-id" asp-for="voteId" />
            <div class="form-group">
                <label asp-for="Votant" class="control-label"></label>
                <input asp-for="Votant" id="votant" class="form-control" />
                <span asp-validation-for="Votant" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CandidatId" class="control-label"></label>
                <select asp-for="CandidatId" id="candidatId" class="form-control" asp-items="ViewBag.CandidatId"></select>
                <span asp-validation-for="CandidatId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" id="editVote" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
     <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script>
        document.getElementById("editVote").addEventListener("click", function (event) {
            event.preventDefault();
    var votant = document.getElementById("votant").value;
    var candidatId = document.getElementById("candidatId").value;
    var voteId = document.getElementById("edit-id").value;
    

    const vote = {
    voteId : parseInt(voteId, 10),
    votant: votant.trim(),
    candidatId: parseInt(candidatId, 10),
  };

    fetch(`/api/VoteApi/${voteId}`, {
        method: "PUT",
        headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(vote)
    })
    .then(response => {
        if (response.ok) {
            window.location.href = '/Votes';
        } else {
            throw new Error('Network response was not ok. Status: ' + response.status + ' - ' + response.statusText);
        }
        //console.log(response);
        //return response.json(); // Convertit la réponse en JSON
    })
    .then(data => {
        if (data !== null) {
            console.log("API Data:", data);
        }

        // Vérifier la connection de signalR
        
    })
    .catch(error => alert("Il y'a une erreur" + error));

    
});
    </script>
}