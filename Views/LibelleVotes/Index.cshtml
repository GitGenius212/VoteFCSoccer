@model IEnumerable<VoteFCSoccer.Models.LibelleVote>

@{
    ViewData["Title"] = "Liste des Libellés de Votes";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="text-primary">Liste des Libellés de Votes</h1>
        <a asp-action="Create" class="btn btn-success btn-lg">
            <i class="fas fa-plus-circle"></i> Ajouter un nouveau libellé
        </a>
    </div>

    <div class="card shadow-lg">
        <div class="card-body">
            <table class="table table-hover table-bordered shadow-sm align-middle text-center">
        <thead class="table-primary">
            <tr>
                <th>#</th>
                <th scope="col">Libellé</th>
                <th scope="col" class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody id="libelleVotes">
            <!-- Les lignes seront ajoutées dynamiquement par JavaScript -->
        </tbody>
    </table>
        </div>
    </div>
    
</div>

    <style>
        .table {
    font-size: 1rem;
}

.table th, .table td {
    vertical-align: middle;
}

.btn-success {
    box-shadow: 0px 4px 6px rgba(0, 128, 0, 0.3);
    transition: transform 0.2s ease;
}

.btn-success:hover {
    transform: scale(1.05);
}

    </style>

@section Scripts {
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script src="~/js/LibelleVote.js"></script>
    <script type="text/javascript">
        getLibelleVotes();
    </script>
}
