@model VoteFCSoccer.Models.LibelleVote

@{
    ViewData["Title"] = "Delete";
}

<div class="container mt-5">
    <div class="card shadow-lg border-danger">
        <div class="card-header bg-danger text-white text-center">
            <h1 class="card-title">Supprimer un Libellé</h1>
        </div>
        <div class="card-body">
            <h3 class="text-center text-danger">Êtes-vous sûr de vouloir supprimer cet élément ?</h3>
            <div class="mt-4">
                <h4 class="text-center text-dark">Détails du libellé</h4>
                <hr class="border border-danger w-75 mx-auto">
                <dl class="row">
                    <dt class="col-sm-4 text-end fw-bold">
                        @Html.DisplayNameFor(model => model.Libelle)
                    </dt>
                    <dd class="col-sm-8">
                        @Html.DisplayFor(model => model.Libelle)
                    </dd>
                </dl>
            </div>
        </div>
        <div class="card-footer text-center">
            <form asp-action="Delete" class="d-inline">
                <input type="hidden" id="delete-id" asp-for="LibelleId" />
                <button type="submit" id="deleteLibelleV" class="btn btn-danger btn-lg">
                    <i class="fas fa-trash-alt"></i> Supprimer
                </button>
            </form>
            <a asp-action="Index" class="btn btn-secondary btn-lg ms-3">
                <i class="fas fa-arrow-left"></i> Annuler
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script src="~/js/LibelleVote.js"></script>
    <script>
        var id = document.getElementById("delete-id").value;
        const deleteUrl = `/api/LibelleVoteApi/${id}`;
        
        document.getElementById("deleteLibelleV").addEventListener("click", function (event) {
            event.preventDefault();
            fetch(deleteUrl, {
                method: "DELETE",
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json'
                }
            })
            .then(response => {
                if (response.ok) {
                    window.location.href = '/LibelleVotes';
                } else {
                    throw new Error('La suppression a échoué.');
                }
            })
            .then(async () => {
                try {
                    await connection.invoke("SendLibelleVote");
                } catch (err) {
                    console.error(err);
                }
            })
            .catch(error => alert(error.message));
        });
    </script>
}
