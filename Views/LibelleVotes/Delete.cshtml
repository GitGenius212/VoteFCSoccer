@model VoteFCSoccer.Models.LibelleVote

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>LibelleVote</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Libelle)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Libelle)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" id="id" asp-for="LibelleId" />
        <input type="submit" value="Delete" class="btn btn-danger" onclick="delete()"/> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>

@section Scripts{
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script src="~/js/LibelleVote.js"></script>
    <script>
        function delete() {
            let id = document.getElementById('id')
            deleteLibelleVote(id)
        }
    </script>
}