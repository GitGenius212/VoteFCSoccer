@model VoteFCSoccer.Models.LibelleVote

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>LibelleVote</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" id="edit-id" asp-for="LibelleId" />
            <div class="form-group">
                <label asp-for="Libelle" class="control-label"></label>
                <input id="libelle" asp-for="Libelle" class="form-control" />
                <span asp-validation-for="Libelle" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" id="editLibelleVote" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script src="~/js/LibelleVote.js"></script>
    <script>
        document.getElementById("editLibelleVote").addEventListener("click", function (event) {
            event.preventDefault();
            const LibelleVoteId = document.getElementById('edit-id').value;
            const libelleVote = {
                libelleId: parseInt(LibelleVoteId, 10),
                libelle: document.getElementById('libelle').value.trim()
            };
    fetch(`/api/LibelleVoteApi/${LibelleVoteId}`, {
        method: "PUT",
        headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(libelleVote)
    })
    .then(response => {
        if (response.ok) {
            window.location.href = '/LibelleVotes';
        } else {
            throw new Error('Network response was not ok. Status: ' + response.status + ' - ' + response.statusText);
        }
        //console.log(response);
        //return response.json(); // Convertit la réponse en JSON
    })
    .then(data => {
        if (data !== null) {
            //console.log("API Data:", data);
        }

    })
    .catch(error => alert("Il y'a une erreur"));
});
    </script>
}
