@model VoteFCSoccer.Models.LibelleVote

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>LibelleVote</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" onsubmit="updateLibelleVote()" >
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" id="edit-id" asp-for="LibelleId" />
            <div class="form-group">
                <label asp-for="Libelle" class="control-label"></label>
                <input id="libelle" asp-for="Libelle" class="form-control" />
                <span asp-validation-for="Libelle" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script src="~/js/LibelleVote.js"></script>
}
