@model VoteFCSoccer.Models.LibelleVote

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>LibelleVote</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" >
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Libelle" class="control-label"></label>
                <input id="libelle" asp-for="Libelle" class="form-control" />
                <span asp-validation-for="Libelle" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" id="createLibelleV" value="Create" class="btn btn-primary" onclick=""/>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script src="~/js/LibelleVote.js"></script>
    <script>
        document.getElementById("createLibelleV").addEventListener("click", function (event) {
    var libelle = document.getElementById("libelle").value.trim();
    event.preventDefault();

    const libelleVote = {
        libelle: libelle,
    };

    fetch('/api/LibelleVoteApi', {
        method: "POST",
        headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(libelleVote)
    })
    .then(response => {
        if (response.ok) {
            // Redirection vers l'Index après succès
            window.location.href = '/LibelleVotes';
        } else {
            // Affiche un message d'erreur si la création échoue
            alert("Erreur lors de la création du libelleVote.");
        }
    })
    .then(async () => {
        try {
            await connection.invoke("SendLibelleVote");
        } catch (err) {
            console.error(err);
        }
    })
    .catch(error => alert(error));
});
    </script>
}
