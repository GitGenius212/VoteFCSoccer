@model VoteFCSoccer.Models.Candidat

@{
    ViewData["Title"] = "Supprimer";
}

<div class="container mt-5">
    <div class="card shadow-lg border-danger">
        <div class="card-header bg-danger text-white text-center">
            <h1 class="card-title">Supprimer un Candidat</h1>
        </div>
        <div class="card-body">
            <h3 class="text-center text-danger">Êtes-vous sûr de vouloir supprimer cet élément ?</h3>
            <div class="mt-4">
                <h4 class="text-center text-dark">Détails du Candidat</h4>
                <hr class="border border-danger w-75 mx-auto">
                <dl class="row">
                    <dt class="col-sm-4 text-end fw-bold">Nom</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Nom)</dd>

                    <dt class="col-sm text-end fw-bold">Logo</dt>
                    <dd class="col-sm-8">
                        <img src="@Html.DisplayFor(model => model.Logo)" alt="Logo" class="img-thumbnail" style="max-height: 150px;" />
                    </dd>

                    <dt class="col-sm-4 text-end fw-bold">Libelle Vote</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.LibelleVote.LibelleId)</dd>
                </dl>
            </div>
            
            <div class="card-footer text-center">
                <form asp-action="Delete" class="d-inline">
                <input type="hidden" id="id" asp-for="CandidatId" />
                    <button type="submit" id="deletebCandidat" class="btn btn-danger btn-lg">
                        <i class="fas fa-trash"></i> Supprimer
                    </button>
            </form>
            <a asp-action="Index" class="btn btn-secondary btn-lg ms-3">
                        <i class="fas fa-arrow-left"></i> Annuler
            </a>
            </div>
            
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script src="~/js/Candidat.js"></script>
    <script>
        const id = document.getElementById("id").value;
        const deleteUrl = `/api/CandidatApi/${id}`;

        document.getElementById("deletebCandidat").addEventListener("click", function (event) {
            event.preventDefault();

            fetch(deleteUrl, {
                method: "DELETE",
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json'
                }
            })
                .then(response => {
                    if (response.ok) {
                        window.location.href = '/Candidats';
                    } else {
                        throw new Error('Erreur réseau : ' + response.status);
                    }
                })
                .then(async () => {
                    try {
                        await connection.invoke("SendCandidatHub");
                    } catch (err) {
                        console.error(err);
                    }
                })
                .catch(error => alert("Une erreur est survenue : " + error.message));
        });
    </script>
}
