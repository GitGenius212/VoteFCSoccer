@model VoteFCSoccer.Models.Candidat

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Candidat</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nom)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nom)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Logo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Logo)
        </dd>
        
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.LibelleVote)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.LibelleVote.LibelleId)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" id="id" asp-for="CandidatId" />
        <input type="submit" value="Delete" id="deletebCandidat" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/Candidat.js"></script>
    <script>
        
        var id = document.getElementById("id").value;
        const deleteUrl = `/api/CandidatApi/${id}`
        document.getElementById("deletebCandidat").addEventListener("click", function (event) {
    fetch(deleteUrl, {
        method: "DELETE",
        headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json'
        }
    })
    .then(response => {
        if (response.ok) {
            window.location.href = '/Candidats';
            
        } else{
            throw new Error('Network response was not ok.');
        }
        // Vérifie si la réponse est vide avant de la convertir en JSON
        const contentType = response.headers.get('content-type');
        if (contentType && contentType.indexOf('application/json') !== -1) {
            return response.json();
        } else {
            return null; // Si la réponse est vide
        }
    })
    .then(data => {
        if (data) {
            // Faites quelque chose avec les données si nécessaire
            //console.log(data);
        }
    })
    .catch(error => alert(error.message));
    event.preventDefault();
});
    </script>
}
