@model VoteFCSoccer.Models.Candidat

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Candidat</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" id="id" asp-for="CandidatId" />
            <div class="form-group">
                <label asp-for="Nom" class="control-label"></label>
                <input asp-for="Nom" class="form-control" />
                <span asp-validation-for="Nom" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Logo" class="control-label"></label>
                <input asp-for="Logo" class="form-control" />
                <span asp-validation-for="Logo" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="LibelleId" class="control-label"></label>
                <select asp-for="LibelleId" class="form-control" asp-items="ViewBag.LibelleId"></select>
                <span asp-validation-for="LibelleId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" id="saveCandidat" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
    
        document.getElementById("saveCandidat").addEventListener("click", function (event) {
            event.preventDefault();
            var nom = document.getElementById("Nom").value;
            var logo = document.getElementById("Logo").value;
            var libelleId = document.getElementById("LibelleId").value;
            var candidatId = document.getElementById("id").value;

    const candidat = {
        candidatId: parseInt(candidatId, 10),
        nom: nom,
        logo: logo,
        libelleId: parseInt(libelleId, 10), 
    };

    fetch(`/api/CandidatApi/${candidatId}`, {
        method: "PUT",
        headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(candidat)
    })
    .then(response => {
        if (response.ok) {
            window.location.href = '/Candidats';
            
        } else {
            throw new Error('Network response was not ok. Status: ' + response.status + ' - ' + response.statusText);
        }
        //console.log(response);
        //return response.json(); // Convertit la réponse en JSON
    })
    .then(data => {
        if (data !== null) {
            //console.log("API Data:", data);
        }

        
    })
    .catch(error => alert("Il y'a une erreur"));

    
});
    </script>
}
